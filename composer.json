{
    "name": "klaxon/touche-pas-au-klaxon",
    "description": "Application de covoiturage intranet — CEF MVC PHP",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "izniburak/router": "^3.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
